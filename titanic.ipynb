import pandas as pd
from sklearn.preprocessing import LabelEncoder, StandardScaler
from sklearn.tree import DecisionTreeClassifier
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

# 1. Load the Dataset
df = pd.read_csv(r'Titanic-Dataset.csv')

# 2. Inspect Data Shape & Missing Values
print("Initial Shape:", df.shape)
print("\nMissing Values Before Imputation:\n", df.isnull().sum())

# 3. Handle Missing Values
for col in df.columns:
    if df[col].dtype != 'object':
        df[col] = df[col].fillna(df[col].mean())
    else:
        mode_val = df[col].mode()
        fallback = mode_val[0] if not mode_val.empty else 'Unknown'
        df[col] = df[col].fillna(fallback)


df.drop_duplicates(inplace=True)

df.drop(columns=['PassengerId', 'Name', 'Ticket', 'Cabin'], inplace=True, errors='ignore')


df['Family_Size'] = df['SibSp'] + df['Parch']
df['Family_Size'] = df['Family_Size'].astype(int)


label_encoder = LabelEncoder()
categorical_cols = [col for col in df.columns if df[col].dtype == 'object']
for col in categorical_cols:
    df[col] = label_encoder.fit_transform(df[col].astype(str))


X = df.drop(columns=['Survived'])
Y = df['Survived']


X_train, X_test, Y_train, Y_test = train_test_split(X, Y, train_size=0.7, random_state=42)


scaler = StandardScaler()
X_train = scaler.fit_transform(X_train)
X_test = scaler.transform(X_test)


model = DecisionTreeClassifier(random_state=42)
model.fit(X_train, Y_train)

Y_pred = model.predict(X_test)
accuracy = accuracy_score(Y_test, Y_pred)

print("\n--- Model Evaluation ---")
print(f"Accuracy: {accuracy * 100:.2f}%")
